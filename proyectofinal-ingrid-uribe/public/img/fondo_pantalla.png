e="text/css" href="./fondo_pantalla_files/f813678c40c7.css"><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/18ad5d9adcf9.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/88add912529d.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/463edaccc0c7.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/a5a032dab1ac.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/853c4a0060ad.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/bbbd406c1a11.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/da2f2e7a9dbc.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/91feffbc9b78.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/9c650c41996d.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/82859e5277d0.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/02e243989d6e.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/cf2a34846382.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/a20241cfa747.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/83d16830b71a.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/18f846cb2f5f.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/a3a76ffc5dc9.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/ae840f763b94.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/d374bcf329b5.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/64dc0fe2bd12.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/f7f76920fde6.css"><link rel="stylesheet" type="text/css" href="./fondo_pantalla_files/3f07f8f266b6.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><span data-radix-focus-start="" style="display:contents"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();

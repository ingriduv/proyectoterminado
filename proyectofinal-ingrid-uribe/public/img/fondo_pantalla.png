cfe40590b2f9e.svg#codex-icon-bookmark-light-20" fill="currentColor"></use></svg></span></button></div></div></div></div></div><div aria-hidden="true" class="Frame-QDM1Eq"></div></div></div></div></div></div></div><ol class="List-rH8nmc" data-d-component="list" data-d-marker="number" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run">Elegí una fotografía de agua como la referencia.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run">Guardala con el nombre exacto </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run">fondo-agua.jpg</span></code><span data-d-stream-run="" data-d-text-flow="run">.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run">Colocala dentro de la carpeta </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run">img</span></code><span data-d-stream-run="" data-d-text-flow="run"> de tu proyecto, junto a las otras imágenes.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run">El CSS ya está preparado para buscarla ahí.</span></p></div></div></li></ol><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run">Importante:</span></span><span data-d-stream-run="" data-d-text-flow="run"> el botón por ahora es solamente visual; todavía no envía mensajes.</span></p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run">No hace falta ningún </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run">@for</span></code><span data-d-stream-run="" data-d-text-flow="run">, </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run">@if</span></code><span data-d-stream-run="" data-d-text-flow="run"> ni código complicado de Angular. Es HTML y CSS, como venimos trabajando. 💙</span></p></div></div></div><div class="contents"></div></div></div></div></div></div></div></div><div class="actionRow-nqqZbm mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:mt-3 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 browser:-ms-0.5 electron:-translate-x-1 extension:-translate-x-1.5 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opac
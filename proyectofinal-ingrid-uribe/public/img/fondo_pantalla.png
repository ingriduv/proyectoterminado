/* ===== FONDO DE CONTACTO ===== */

.contacto {
  min-height: 100vh;
  padding: 65px 20px;

  background:
    linear-gradient(rgba(0, 12, 28, 0.45), rgba(0, 10, 25, 0.65)),
    url('/img/fondo-agua.jpg');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  justify-content: center;
  align-items: center;

  color: #eaf8ff;
}

/* ===== CONTENEDOR CENTRAL ===== */

.contenedor-contacto {
  width: 100%;
  max-width: 600px;
  padding: 40px;

  background: rgba(3, 19, 38, 0.82);
  border: 1px solid rgba(39, 223, 255, 0.5);
  border-radius: 20px;

  box-shadow: 0 0 35px rgba(0, 140, 255, 0.25);

  backdrop-filter: blur(10px);
}

/* ===== ENCABEZADO ===== */

.encabezado-contacto {
  text-align: center;
  margin-bottom: 30px;
}

.subtitulo {
  color: #27dfff;
  font-size: 12px;
  letter-spacing: 4px;
  margin-bottom: 12px;
}

.encabezado-contacto h1 {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 15px;
}

.encabezado-contacto h1 span {
  color: #27dfff;
}

.encabezado-contacto p:last-child {
  color: #b8d4e8;
  font-size: 14px;
  line-height: 1.7;
}

/* ===== FORMULARIO ===== */

.contenedor-contacto form {
  display: flex;
  flex-direction: column;
}

.contenedor-contacto label {
  margin-bottom: 8px;
  margin-top: 15px;
  color: #d8f5ff;
  font-size: 14px;
}

.contenedor-contacto input,
.contenedor-contacto textarea {
  padding: 13px;
  border: 1px solid #23658a;
  border-radius: 9px;

  background: rgba(2, 15, 30, 0.85);
  color: white;

  outline: none;
  font-size: 14px;
}

.contenedor-contacto input:focus,
.contenedor-contacto textarea:focus {
  border-color: #27dfff;
  box-shadow: 0 0 10px #27dfff55;
}

.contenedor-contacto input::placeholder,
.contenedor-contacto textarea::placeholder {
  color: #7896aa;
}

.contenedor-contacto textarea {
  min-height: 120px;
  resize: vertical;
}

/* ===== BOTÓN ===== */

.contenedor-contacto button {
  margin-top: 25px;
  padding: 14px;

  border: none;
  border-radius: 9px;

  background: linear-gradient(90deg, #0879c9, #16c8e8);
  color: white;

  font-weight: bold;
  font-size: 15px;

  cursor: pointer;
  transition: 0.3s;
}

.contenedor-contacto button:hover {
  transform: translateY(-3px);
  box-shadow: 0 0 20px #16c8e888;
}

/* ===== FRASE FINAL ===== */

.frase-contacto {
  text-align: center;
  margin-top: 25px;
  margin-bottom: 0;

  color: #27dfff;
  font-size: 11px;
  letter-spacing: 4px;
}

/* ===== PANTALLAS PEQUEÑAS ===== */

@media (max-width: 600px) {

  .contenedor-contacto {
    padding: 25px;
  }

  .encabezado-contacto h1 {
    font-size: 26px;
  }

}
